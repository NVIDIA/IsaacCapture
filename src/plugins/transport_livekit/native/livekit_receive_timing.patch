@@ -164 +165 @@
-                                        payload, keyframe: native.encoded_keyframe(), metadata,
+                                        payload, keyframe: native.encoded_keyframe(), metadata, native_available_ns,
@@ -345,0 +347,13 @@
+
+/// Linux CLOCK_MONOTONIC matches Python's monotonic_ns; absent elsewhere.
+fn umb_monotonic_ns() -> Option<u64> {
+    #[cfg(target_os = "linux")]
+    {
+        let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        // SAFETY: ts is valid writable storage; CLOCK_MONOTONIC needs no privileges.
+        if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) } == 0 {
+            return (ts.tv_sec as u64).checked_mul(1_000_000_000)?.checked_add(ts.tv_nsec as u64);
+        }
+    }
+    None
+}
