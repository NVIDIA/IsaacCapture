+    return std::make_unique<EncodedH264Receiver>();
+  }
diff --git a/webrtc-sys/src/video_frame_buffer.cpp b/webrtc-sys/src/video_frame_buffer.cpp
index a432da9..8495256 100644
--- a/webrtc-sys/src/video_frame_buffer.cpp
+++ b/webrtc-sys/src/video_frame_buffer.cpp
@@ -17,0 +18 @@
+#include "livekit/encoded_video_frame_buffer.h"
@@ -31,0 +33,14 @@ VideoFrameBufferType VideoFrameBuffer::buffer_type() const {
+rust::Vec<uint8_t> VideoFrameBuffer::encoded_payload() const {
+  rust::Vec<uint8_t> data;
+  auto* encoded = livekit::EncodedVideoFrameBuffer::FromNative(buffer_.get());
+  if (encoded) {
+    auto payload = encoded->encoded_data();
+    data.reserve(payload->size());
+    for (size_t i = 0; i < payload->size(); ++i) data.push_back(payload->data()[i]);
+  }
+  return data;
+}
+bool VideoFrameBuffer::encoded_keyframe() const {
+  auto* encoded = livekit::EncodedVideoFrameBuffer::FromNative(buffer_.get());
+  return encoded && encoded->frame_type() == livekit::EncodedFrameType::kKey;
+}
