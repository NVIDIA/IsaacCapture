diff --git a/webrtc-sys/src/video_decoder_factory.cpp b/webrtc-sys/src/video_decoder_factory.cpp
index d22ae70..2716424 100644
--- a/webrtc-sys/src/video_decoder_factory.cpp
+++ b/webrtc-sys/src/video_decoder_factory.cpp
@@ -17,0 +18,5 @@
+#include "livekit/encoded_video_frame_buffer.h"
+#include "api/video/video_frame.h"
+#include "api/make_ref_counted.h"
+#include "modules/video_coding/include/video_error_codes.h"
+#include <cstdlib>
@@ -44,0 +50,31 @@ namespace {
+// Opt-in complete-access-unit handoff; ordinary viewers retain the stock decoder.
+class EncodedH264Receiver final : public webrtc::VideoDecoder {
+ public:
+  bool Configure(const Settings&) override { return true; }
+  int32_t RegisterDecodeCompleteCallback(webrtc::DecodedImageCallback* callback) override {
+    callback_ = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override { callback_ = nullptr; return WEBRTC_VIDEO_CODEC_OK; }
+  DecoderInfo GetDecoderInfo() const override {
+    DecoderInfo info;
+    info.implementation_name = "UMB encoded H264 handoff v1";
+    info.is_hardware_accelerated = false;
+    return info;
+  }
+  int32_t Decode(const webrtc::EncodedImage& image, bool, int64_t) override {
+    if (!callback_ || !image.data() || !image.size()) return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    auto payload = webrtc::EncodedImageBuffer::Create(image.data(), image.size());
+    auto buffer = webrtc::make_ref_counted<livekit::EncodedVideoFrameBuffer>(
+        image._encodedWidth, image._encodedHeight, livekit::EncodedVideoCodec::kH264,
+        image._frameType == webrtc::VideoFrameType::kVideoFrameKey
+          ? livekit::EncodedFrameType::kKey : livekit::EncodedFrameType::kDelta, payload);
+    auto frame = webrtc::VideoFrame::Builder().set_video_frame_buffer(buffer)
+        .set_timestamp_rtp(image.RtpTimestamp()).build();
+    callback_->Decoded(frame, std::nullopt, std::nullopt);
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+ private:
+  webrtc::DecodedImageCallback* callback_ = nullptr;
+};
+
