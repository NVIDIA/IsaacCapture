include "point.fbs";
include "timestamp.fbs";

namespace core;

// Per-frame tactile forces. TactileMetadata (tactile_metadata.fbs) defines the
// taxel order and reference geometry for the same tracker.
table TactileDataArray {
  // Force vectors in newtons, expressed in taxel-local axes. For LBS, taxel_bind_poses
  // define these axes at bind; the vector length equals the metadata taxel count.
  // +X is the calibrated tangent T, +Z is the outward normal N, +Y = N cross T.
  // Component signs follow these axes for both hands, without a side-based flip.
  taxel_forces: [Point] (id: 0, required);
}

// MCAP recording wrapper for TactileDataArray.
table TactileDataArrayRecord {
  data: TactileDataArray (id: 0, required);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type TactileDataArrayRecord;
