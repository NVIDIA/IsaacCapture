include "pose.fbs";
include "soma_common.fbs";
include "soma_hand_joint_rotations.fbs";
include "timestamp.fbs";

namespace core;

struct SomaHandJointPose {
    pose: Pose;
    is_valid: bool;
}

// Fixed-size evaluated SOMA hand joint-pose array in SomaHandJoint order.
struct SomaHandJointPoseArray {
    values: [SomaHandJointPose:25];
}

// Evaluated SOMA hand joint-pose transport schema.
//
// Defined and verified against SOMA-X v0.3.1 and its v0.3 pose interface.
// Every position and orientation is global within the payload reference frame.
// Positions are meters in a right-handed frame with +Y up and +Z forward.
// Orientations are unit XYZW quaternions.
table SomaHandJointPoses {
    joint_poses: SomaHandJointPoseArray (id: 0);
    handedness: SomaHandedness = UNSPECIFIED (id: 1);
}

table SomaHandJointPosesRecord {
    data: SomaHandJointPoses (id: 0);
    timestamp: DeviceDataTimestamp (id: 1);
}

root_type SomaHandJointPosesRecord;
