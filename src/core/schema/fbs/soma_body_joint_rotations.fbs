include "point.fbs";
include "soma_body_common.fbs";
include "quaternion.fbs";
include "timestamp.fbs";

namespace core;

// One explicitly identified SOMA body rotation.
struct SomaBodyJointRotation {
    joint: SomaBodyJoint (key);
    rotation: Quaternion;
}

// SOMA full-body joint-rotation transport schema.
//
// Defined and verified against SOMA-X v0.3.1 and its v0.3 pose interface,
// with reference_pose=None, absolute_pose=False, and its public joint order.
// Producers must convert historical, custom, or vendor-native references before
// publishing. Hips is global in the reference frame; all remaining rotations are
// joint-local relative to that fixed reference pose. A distinct vendor-native
// root transform must be composed into Hips before publishing. Rotations are
// unit XYZW quaternions. Global translation is meters in a right-handed
// reference frame with +Y up and +Z forward.
table SomaBodyJointRotations {
    // Complete current-pose snapshot, sorted ascending and unique by joint.
    // Use CreateVectorOfSortedStructs when building the vector directly.
    // A joint absent from this vector is not provided by the producer.
    joint_rotations: [SomaBodyJointRotation] (id: 0);

    // Translation applied to Hips in the reference frame. Ignore this value
    // when global_translation_is_valid is false.
    global_translation: Point (id: 1);
    global_translation_is_valid: bool (id: 2);
}

table SomaBodyJointRotationsRecord {
    data: SomaBodyJointRotations (id: 0);
    timestamp: DeviceDataTimestamp (id: 1);
}

root_type SomaBodyJointRotationsRecord;
