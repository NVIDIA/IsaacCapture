include "timestamp.fbs";

namespace core;

enum OrbbecEgoImuSensor : byte { Accel = 0, Gyro = 1 }

struct OrbbecEgoImuSample {
  x_si: double;
  y_si: double;
  z_si: double;
  temperature_c: double;
  sample_time_local_common_clock_ns: int64;
  sample_time_raw_device_clock_ns: int64;
}

table OrbbecEgoImuBatch {
  sensor: OrbbecEgoImuSensor (id: 0);
  sequence_number: uint64 (id: 1);
  sample_rate_hz: uint32 (id: 2);
  full_scale: float (id: 3);
  samples: [OrbbecEgoImuSample] (id: 4);
  capture_epoch: uint32 (id: 5);
}

table OrbbecEgoImuBatchTracked { data: OrbbecEgoImuBatch (id: 0); }

table OrbbecEgoImuBatchRecord {
  data: OrbbecEgoImuBatch (id: 0);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type OrbbecEgoImuBatchRecord;
