include "quaternion.fbs";

namespace core;

// Hand side shared by the SOMA pose transport schemas.
enum SomaHandedness : uint8 {
    UNSPECIFIED = 0,
    LEFT = 1,
    RIGHT = 2,
}

// One SOMA rotation and its tracking validity.
//
// Body and hand profiles define the joint order and reference frame.
// Valid rotations are unit XYZW quaternions. q and -q represent the same
// rotation; no quaternion-sign convention is required. Ignore rotation when
// is_valid is false.
struct SomaJointRotation {
    rotation: Quaternion;
    is_valid: bool;
}
