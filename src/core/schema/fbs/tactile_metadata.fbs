include "float4.fbs";
include "hand.fbs";
include "pose.fbs";
include "uint4.fbs";

namespace core;

// The skeleton root is WRIST, with the OpenXR axes from hand.fbs: +Y toward
// the back of the hand, +Z toward the forearm, +X = +Y cross +Z.
// Both hands use these right-handed rules. Hand side and source hand stream
// are associated by the application; this table does not imply mirroring.
table HandSkeletonRef {
  // Ordered, unique HandJoint identifiers; NUM_JOINTS is not a joint.
  // Segment indices address this vector, not HandJoint ordinals. Bind and current
  // segment poses map joint-local coordinates into the same hand-root frame.
  joint_ids: [HandJoint] (id: 0, required); // defined in hand.fbs
}

union SegmentSource {
  HandSkeletonRef = 1,
}

table LBS {
  // Segment-local-to-skeleton-root bind poses, in SegmentSource order.
  // For HandSkeletonRef the root is the WRIST frame at bind, not a joint's
  // parent or the session/world frame. Joint-local axes follow hand.fbs.
  // Positions are in meters; orientations are unit quaternions (x, y, z, w).
  segment_bind_poses: [Pose] (id: 0, required);

  // Taxel-local-to-skeleton-root bind poses, in TactileDataArray.taxel_forces order.
  // The origin is the sensing location. +Z is the outward unit surface normal N;
  // +X is a calibrated unit tangent T orthogonal to N; +Y = N cross T.
  // These axes are right-handed for either hand; T is stored by the orientation,
  // not inferred from hand side. Units and root match segment_bind_poses.
  taxel_bind_poses: [Pose] (id: 1, required);

  // One four-slot row per taxel; all taxel_* vectors have the same length.
  // Every slot indexes segment_bind_poses, including slots whose weight is zero.
  taxel_segment_indices: [UInt4] (id: 2, required);

  // Finite, nonnegative weights, summing to one per taxel. Bind positions move as
  // p(t) = sum_k w_k * T_current[j_k] * inverse(T_bind[j_k]) * p_bind.
  // LBS blends transformed points; it does not define a rigid animated taxel frame.
  taxel_segment_weights: [Float4] (id: 3, required);
}

// Static parameters for the selected taxel geometry-mapping method.
union AlgorithmSource {
  LBS = 1,
}

// Static layout published as tracker metadata, without a timestamp or Record wrapper.
// Required fields enforce presence only; empty vectors still pass verification.
// Lengths, indices and weights require semantic validation by producers/consumers.
table TactileMetadata {
  // The implicit geometry_mapping_type discriminator occupies id 0.
  geometry_mapping: AlgorithmSource (id: 1, required);

  // The implicit segment_source_type discriminator occupies id 2.
  segment_source: SegmentSource (id: 3, required);
}

root_type TactileMetadata;
