include "hand.fbs";
include "pose.fbs";

namespace core;

table HandSkeletonRef {
  // Ordered, unique HandJoint identifiers; NUM_JOINTS is not a joint.
  // Segment indices address this vector, not HandJoint ordinals. Bind and current
  // segment poses map joint-local coordinates into the same hand-root frame.
  joint_ids: [HandJoint] (id: 0);
}

union SegmentSource {
  HandSkeletonRef = 1,
}

struct UInt4 {
  values: [uint32:4];
}

struct Float4 {
  values: [float:4];
}

table LBS {
  // Segment-to-source-frame bind poses, in SegmentSource order. Positions are in
  // meters and orientations are unit quaternions (x, y, z, w).
  segment_bind_poses: [Pose] (id: 0);

  // Taxel-local-to-source-frame bind poses, in TactileDataArray.taxel_forces order.
  // Uses the same units and quaternion convention as segment_bind_poses.
  taxel_bind_poses: [Pose] (id: 1);

  // One four-slot row per taxel; all taxel_* vectors have the same length.
  // Every slot indexes segment_bind_poses, including slots whose weight is zero.
  taxel_segment_indices: [UInt4] (id: 2);

  // Finite, nonnegative weights, summing to one per taxel. Bind positions move as
  // p(t) = sum_k w_k * T_current[j_k] * inverse(T_bind[j_k]) * p_bind.
  // LBS blends transformed points; it does not define a rigid animated taxel frame.
  taxel_segment_weights: [Float4] (id: 3);
}

// Static parameters for the selected taxel geometry-mapping method.
union AlgorithmSource {
  LBS = 1,
}

// Static layout published as tracker metadata, without a timestamp or Record wrapper.
// A usable layout sets both unions; lengths, indices and weights require semantic
// validation by producers/consumers, beyond FlatBuffers buffer verification.
table TactileMetadata {
  // The implicit geometry_mapping_type discriminator occupies id 0.
  geometry_mapping: AlgorithmSource (id: 1);

  // The implicit segment_source_type discriminator occupies id 2.
  segment_source: SegmentSource (id: 3);
}

root_type TactileMetadata;
