// Internal only, not a public schema. Ask Lotus Li (lotusl@nvidia.com) before using it.

include "pose.fbs";
include "timestamp.fbs";

namespace core;

// Four XrHandJointEXT ordinals (HandJoint in hand.fbs), one per skinning slot 0..3.
struct TaxelJointIndices {
  joints: [uint32:4];
}

// Four skinning weights; weights[k] pairs with TaxelJointIndices.joints[k].
struct TaxelJointWeights {
  weights: [float:4];
}

// Hand skeleton and taxel layout at the reference bind pose, for the device that publishes
// TactileData. Joint vectors hold joint_count entries indexed by XrHandJointEXT ordinal; taxel
// vectors hold taxel_count entries in TactileData.taxel_force order. FlatBuffers does not check
// a count against a vector's length, so producers must keep them equal.
//
// Static per device: producers publish it on (re)connect and whenever it changes, then
// republish it periodically. Replay yields it only on the frames it was recorded at, so
// consumers keep the latest one.
table TactileShape {
  joint_count: uint32 (id: 0);

  // Joint pose in hand-root space. Position in meters, unit quaternion.
  joint_bind_poses: [Pose] (id: 1);

  // Parent joint ordinal; the root holds 0x7FFFFFFF (XR_HAND_JOINT_MAX_ENUM_EXT).
  // The hierarchy is acyclic.
  joint_parents: [uint32] (id: 2);

  taxel_count: uint32 (id: 3);

  // Hand-root space: positions in meters; unit normals; unit tangents perpendicular
  // to their normal.
  taxel_positions: [Point] (id: 4);
  taxel_normals: [Point] (id: 5);
  taxel_tangents: [Point] (id: 6);

  // Linear blend skinning. Every slot names a valid joint, zero-weight slots included.
  // Weights are finite and nonnegative, 1-4 of them nonzero, summing to 1. A taxel moves as
  //   p_current = sum_k w_k * T_current[j_k] * inverse(T_bind[j_k]) * p_bind
  // with T_bind from joint_bind_poses and T_current the current joint-to-hand-root
  // transform, both rigid. It blends transformed points, not poses.
  taxel_joint_indices: [TaxelJointIndices] (id: 7);
  taxel_joint_weights: [TaxelJointWeights] (id: 8);

  // Matched by TactileData.device_id / shape_version. shape_version changes whenever any
  // other field does.
  device_id: string (id: 9);
  shape_version: uint32 (id: 10);
}

// MCAP recording wrapper. Record types are the root types written to MCAP
// channels; trackers serialize into Record types in serialize_all().
table TactileShapeRecord {
  data: TactileShape (id: 0);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type TactileShapeRecord;
