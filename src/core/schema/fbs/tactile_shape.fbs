include "pose.fbs";

namespace core;

// One joint of the hand skeleton at the reference bind pose.
struct TactileJoint {
  // Pose in hand-root space. Position in meters, unit quaternion.
  bind_pose: Pose;

  // Parent joint ordinal; the root holds 0x7FFFFFFF (XR_HAND_JOINT_MAX_ENUM_EXT).
  // The hierarchy is acyclic.
  parent: uint32;
}

// One taxel at the reference bind pose, in hand-root space.
struct TactileTaxel {
  // Position in meters; unit normal; unit tangent perpendicular to the normal.
  position: Point;
  normal: Point;
  tangent: Point;

  // Linear blend skinning over four slots: joint_indices[k], an XrHandJointEXT ordinal (HandJoint
  // in hand.fbs), weighted by joint_weights[k]. Every slot names a valid joint, zero-weight slots
  // included. Weights are finite and nonnegative, 1-4 of them nonzero, summing to 1. A taxel moves as
  //   p_current = sum_k w_k * T_current[j_k] * inverse(T_bind[j_k]) * p_bind
  // with T_bind from the joint's bind_pose and T_current the current joint-to-hand-root
  // transform, both rigid. It blends transformed points, not poses.
  joint_indices: [uint32:4];
  joint_weights: [float:4];
}

// Hand skeleton and taxel layout at the reference bind pose, for the device that publishes
// TactileData. `joints` is indexed by XrHandJointEXT ordinal; `taxels` is in
// TactileData.taxel_force order.
//
// Its own root rather than a Record: it is fixed for the life of the producer's collections, so
// it has no capture time, and frames carry no shape version; a different shape needs new
// collections (a producer restart). Producers publish it on connect, then republish it
// periodically. Replay reads one message per update, not by timestamp, so the recorded shapes
// run out after the first few frames; consumers keep the latest one.
table TactileShape {
  joints: [TactileJoint] (id: 0);
  taxels: [TactileTaxel] (id: 1);
}

root_type TactileShape;
