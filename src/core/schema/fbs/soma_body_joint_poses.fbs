include "pose.fbs";
include "soma_body_common.fbs";
include "timestamp.fbs";

namespace core;

struct SomaBodyJointPose {
    pose: Pose;
    is_valid: bool;
}

// Fixed-size evaluated SOMA body joint-pose array in SomaBodyJoint order.
struct SomaBodyJointPoseArray {
    values: [SomaBodyJointPose:77];
}

// Evaluated SOMA full-body joint-pose transport schema.
//
// Defined and verified against SOMA-X v0.3.1 and its v0.3 pose interface.
// Every position and orientation is global within the payload reference frame.
// Positions are meters in a right-handed frame with +Y up and +Z forward.
// Orientations are unit XYZW quaternions. The virtual Root is omitted.
table SomaBodyJointPoses {
    joint_poses: SomaBodyJointPoseArray (id: 0);
}

table SomaBodyJointPosesRecord {
    data: SomaBodyJointPoses (id: 0);
    timestamp: DeviceDataTimestamp (id: 1);
}

root_type SomaBodyJointPosesRecord;
