include "quaternion.fbs";

namespace core;

// One SOMA rotation and its tracking validity.
//
// Versioned body profiles define the joint order and reference frame.
// Valid rotations are unit XYZW quaternions. q and -q represent the same
// rotation; no quaternion-sign convention is required. Ignore rotation when
// is_valid is false.
struct SomaJointRotationV0 {
    rotation: Quaternion;
    is_valid: bool;
}
