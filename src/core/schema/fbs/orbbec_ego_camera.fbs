include "timestamp.fbs";

namespace core;

// The two RGB sensors exposed by the EGO camera.
enum OrbbecEgoCameraStream : byte { ColorLeft = 0, ColorRight = 1 }

// Values are append-only: existing recordings use Mjpg == 0.
enum OrbbecEgoPixelFormat : byte { Mjpg = 0, H264 = 1, H265 = 2 }

// Per-frame metadata pushed independently for each recorded stream.
table OrbbecEgoFrameMetadata {
  stream: OrbbecEgoCameraStream (id: 0);
  sequence_number: uint64 (id: 1);
  width: uint32 (id: 2);
  height: uint32 (id: 3);
  fps: uint32 (id: 4);
  pixel_format: OrbbecEgoPixelFormat (id: 5);
  encoded_bytes: uint64 (id: 6);
  capture_epoch: uint32 (id: 7);
}

// MCAP record wrapper. DeviceDataTimestamp carries host and device clock values.
table OrbbecEgoFrameMetadataRecord {
  data: OrbbecEgoFrameMetadata (id: 0);
  timestamp: DeviceDataTimestamp (id: 1);
}

root_type OrbbecEgoFrameMetadataRecord;
