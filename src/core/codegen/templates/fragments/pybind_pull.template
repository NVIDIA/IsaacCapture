    py::class_<core::@CLASS@, core::ITracker, std::shared_ptr<core::@CLASS@>>(m, "@CLASS@")
        .def(py::init<const std::string&, size_t>(), py::arg("collection_id"),
             py::arg("max_flatbuffer_size") = core::@CLASS@::DEFAULT_MAX_FLATBUFFER_SIZE)
        .def(
            "@PYTHON_ACCESSOR@",
            [](const core::@CLASS@& self, const core::ITrackerSession& session)
            { return to_python(self.get_data(session)); },
            py::arg("session"),
            "Get the current state (None when no data available)")
#if @HAS_METADATA@
        .def(
            "get_metadata",
            [](const core::@CLASS@& self, const core::ITrackerSession& session)
            { return to_python(self.get_metadata(session)); },
            py::arg("session"),
