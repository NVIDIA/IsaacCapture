std::unique_ptr<@IFACE@> LiveDeviceIOFactory::create_@NAME@_tracker_impl(const @CLASS@* tracker)
{
    std::unique_ptr<@MCAP_CHANNELS_TYPE@> channels;
    if (should_record(tracker)) {
        channels = @LIVE_IMPL@::create_mcap_channels(*writer_, get_name(tracker));
    }
    return std::make_unique<@LIVE_IMPL@>(handles_, tracker, std::move(channels));
}
