#include <deviceio_trackers/@HEADER@.hpp>

namespace core
{
@CLASS@::@CLASS@(const std::string& collection_id, size_t max_flatbuffer_size)
    : collection_id_(collection_id), max_flatbuffer_size_(max_flatbuffer_size)
{
    // No-op: members set in the initializer list.
}
const Serialized<@FB_TABLE@>& @CLASS@::get_data(const ITrackerSession& session) const
{
    return static_cast<const @IFACE@&>(session.get_tracker_impl(*this)).get_data();
}
#if @HAS_METADATA@
const Serialized<@METADATA@>& @CLASS@::get_metadata(const ITrackerSession& session) const
{
    return static_cast<const @IFACE@&>(session.get_tracker_impl(*this)).get_metadata();
}
#endif
} // namespace core
