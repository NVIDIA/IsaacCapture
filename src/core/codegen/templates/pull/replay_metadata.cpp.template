#include "@REPLAY_IMPL_FILE@.hpp"

#include <mcap/recording_traits.hpp>
#include <schema/@METADATA_SCHEMA@_bfbs_generated.h>
#include <schema/@SCHEMA@_bfbs_generated.h>

#include <utility>
#include <vector>

namespace core
{
namespace
{
// Live records the metadata once, before any data it lets through, so the first message is the
// one every recorded frame was published with.
Serialized<@METADATA@> read_@NAME@_metadata(std::unique_ptr<mcap::McapReader> reader,
                                            std::string_view base_name,
                                            const RecordedSchemas& recorded)
{
    McapTrackerViewers<@METADATA@> viewers(
        std::move(reader), base_name,
        std::vector<std::string>(@TRAITS@::metadata_channels.begin(), @TRAITS@::metadata_channels.end()), recorded);
    return viewers.read(0);
}
} // namespace
@REPLAY_IMPL@::@REPLAY_IMPL@(std::unique_ptr<mcap::McapReader> reader,
                             std::unique_ptr<mcap::McapReader> metadata_reader,
                             std::string_view base_name,
                             const RecordedSchemas& recorded)
    : metadata_(read_@NAME@_metadata(std::move(metadata_reader), base_name, recorded)),
      mcap_viewers_(std::make_unique<@MCAP_VIEWERS_TYPE@>(
          std::move(reader),
          base_name,
          std::vector<std::string>(@TRAITS@::replay_channels.begin(), @TRAITS@::replay_channels.end()),
          recorded)),
      logger_(isaaccapture::Logger::get("isaaccapture.core.@REPLAY_IMPL@")),
      no_data_message_("no data (EOF or gap), base_name=" + std::string(base_name))
{
    if (!metadata_)
    {
        logger_->warn("recording has no {} for base_name={}; its data will not be published",
                      @METADATA@::GetFullyQualifiedName(), base_name);
    }
}
const Serialized<@FB_TABLE@>& @REPLAY_IMPL@::get_data() const
{
    return tracked_;
}
const Serialized<@METADATA@>& @REPLAY_IMPL@::get_metadata() const
{
    return metadata_;
}
void @REPLAY_IMPL@::update(int64_t /*monotonic_time_ns*/)
{
    auto record = mcap_viewers_->read(0);
    if (record)
    {
        // Mirrors live, which publishes data only with its metadata.
        tracked_ = metadata_ ? record.narrow(record->data()) : Serialized<@FB_TABLE@>();
        warned_no_data_ = false;
    }
    else
    {
        if (!warned_no_data_)
        {
            logger_->warn("{}", no_data_message_);
            warned_no_data_ = true;
        }
        tracked_.reset();
    }
}
} // namespace core
