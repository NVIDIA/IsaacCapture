{
  "schema": {
    "mcap_schema_name": "core.FullBodyPoseRecord",
    "schema_encoding": "flatbuffer",
    "schema_data": "binary FlatBuffers schema (.bfbs) for full_body.fbs",
    "message_encoding": "flatbuffer",
    "topic": "full_body/full_body",
    "mcap_profile": "teleop",
    "log_time": "available_time_local_common_clock",
    "publish_time": "available_time_local_common_clock"
  },
  "conventions": {
    "up_axis": "+Y",
    "handedness": "right",
    "facing": "-Z",
    "lateral": "+X is the subject's right, -X the subject's left",
    "position_units": "metres",
    "quaternion_order": "x, y, z, w",
    "nominal_rate_hz": 60.0
  },
  "categories": {
    "golden": "clean and correct; the checker must report an overall pass",
    "benign": "unusual but correct; the checker must also pass these -- they are the false-positive guards, modelled on the Noitom plugin's output",
    "defect": "exactly one injected fault; the checker must fail the named check"
  },
  "fixtures": [
    {
      "filename": "fixtures/golden_scripted_sequence.mcap",
      "batch": "envelope",
      "category": "golden",
      "description": "14 s @ 60 Hz: A-pose still, T-pose hold, single right-arm raise, single left-leg raise, return to T-pose. Y-up right-handed metres, all joints valid.",
      "expected_verdict": "pass",
      "frames": 840,
      "size_bytes": 745972
    },
    {
      "filename": "fixtures/golden_tpose_hold.mcap",
      "batch": "envelope",
      "category": "golden",
      "description": "6 s @ 60 Hz static T-pose hold with breathing sway only -- a minimal baseline for still-window statistics and noise-floor estimation.",
      "expected_verdict": "pass",
      "frames": 360,
      "size_bytes": 324052
    },
    {
      "filename": "fixtures/benign_invalid_joints_zero_pose.mcap",
      "batch": "envelope",
      "category": "benign",
      "description": "Four joints the vendor does not provide (collars, feet) are permanently is_valid=false carrying an all-zero Point and all-zero Quaternion -- byte-for-byte what make_invalid_body_joint_pose() emits in the Noitom plugin. A quaternion-norm check applied unconditionally would wrongly fail this valid output.",
      "expected_verdict": "pass",
      "frames": 840,
      "size_bytes": 745972
    },
    {
      "filename": "fixtures/benign_backfilled_endpoints.mcap",
      "batch": "envelope",
      "category": "benign",
      "description": "Hands and feet are back-filled from the wrists and ankles and marked valid, as the Noitom plugin does for a skeleton with no hand/foot joints. Consequence: those four bones have a constantly zero length. Legitimate -- reportable as 'derived, not measured', but not a fault.",
      "expected_verdict": "pass",
      "frames": 840,
      "size_bytes": 745972
    },
    {
      "filename": "fixtures/benign_dropout_recovery.mcap",
      "batch": "envelope",
      "category": "benign",
      "description": "The whole left-arm chain goes is_valid=false (zero pose) for ~1 s mid-run and then recovers cleanly; all_joint_poses_tracked follows. A transient occlusion, not a broken integration.",
      "expected_verdict": "pass",
      "frames": 840,
      "size_bytes": 745972
    },
    {
      "filename": "fixtures/defect_z_up.mcap",
      "batch": "envelope",
      "category": "defect",
      "description": "Whole rig expressed Z-up instead of Y-up (right-handed throughout): positions and orientations both rotated +90 deg about X.",
      "expected_verdict": "fail",
      "frames": 840,
      "size_bytes": 745972,
      "expected_failing_check": "coordinate_frame.up_axis"
    },
    {
      "filename": "fixtures/defect_centimetre_units.mcap",
