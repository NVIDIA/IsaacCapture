{
  "name": "cloudxr-isaac-lab-teleop",
  "version": "6.3.0",
  "private": true,
  "description": "NVIDIA Isaac Teleop Web Client",
  "author": "NVIDIA Corporation",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "three.js",
    "webxr",
    "cloudxr",
    "vr"
  ],
  "scripts": {
    "build": "webpack --config ./webpack.prod.js",
    "dev": "webpack --config ./webpack.dev.js",
    "dev-server": "webpack serve --config ./webpack.dev.js --no-open",
    "dev-server:https": "cross-env HTTPS=true webpack serve --config ./webpack.dev.js --no-open",
    "dev-server:mock": "webpack serve --config ./webpack.mock.js",
    "build:mock": "webpack --config ./webpack.mock.js",
    "dev-server:app-mock": "webpack serve --config ./webpack.app-mock.js",
    "build:app-mock": "webpack --config ./webpack.app-mock.js",
    "dev-server:component-mock": "webpack serve --config ./webpack.component-mock.js",
    "build:component-mock": "webpack --config ./webpack.component-mock.js",
    "test:playwright": "playwright test",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rimraf dist",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\" \"helpers/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --ignore-pattern \"**/build/**\" --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/dist/**\" --quiet",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"helpers/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --ignore-pattern \"**/build/**\" --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/dist/**\" --quiet --fix",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,html,css,json,md}\" \"helpers/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,html,js}\" \"webpack.*.js\" \"eslint.config.js\" \"*.{js,json,md}\"",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,html,css,json,md}\" \"helpers/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,html,js}\" \"webpack.*.js\" \"eslint.config.js\" \"*.{js,json,md}\"",
    "format:check": "npm run lint:check && npm run prettier:check",
    "format": "npm run lint && npm run prettier"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/helpers",
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/playwright/"
    ]
  },
  "dependencies": {
    "@nvidia/cloudxr": "file:../nvidia-cloudxr-6.3.0.tgz",
    "@preact/signals-react": "^3.10.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/handle": "^6.6.29",
    "@react-three/uikit": "^1.0.64",
    "@react-three/uikit-default": "^1.0.64",
    "@react-three/xr": "^6.6.29",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "three": "^0.184.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@webxr-input-profiles/assets": "1.0.20",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.8.1",
    "eslint": "9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "html-webpack-plugin": "^5.6.7",
    "iwer": "^2.3.0",
    "jest": "^30",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "3.5.3",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "ts-jest": "^29",
    "ts-loader": "^9.5.7",
    "typescript": "^5.8.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3",
    "ws": "^8.22.0"
  }
}
